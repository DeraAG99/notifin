# Infrastructure credentials (optional - semua udah ada default di docker-compose.yml)
# Cukup set kalo mau ganti dari default

POSTGRES_DB=notifin
POSTGRES_USER=notifin
POSTGRES_PASSWORD=notifin_secret

APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# Auth
JWT_SECRET=notifin-docker-secret-change-me

# Set ke false kalau akses dashboard lewat HTTP (bukan HTTPS)
COOKIE_SECURE=true

# OpenWA
OPENWA_API_KEY=notifin_openwa_key
OPENWA_PORT=2785
OPENWA_DB=openwa
OPENWA_USER=notifin
OPENWA_PASSWORD=notifin_secret
