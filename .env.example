# Database
DATABASE_URL=postgresql://user:password@localhost:5432/notifin

# Redis
REDIS_URL=redis://localhost:6379

# Fonnte WhatsApp Gateway
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_RATE_LIMIT=100

# Email (SMTP)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_password
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME=Notifin

# Resend (platform email provider - "Notifin mail")
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Notifin" <notifications@notifin.app>

# Auth
JWT_SECRET=your-secret-key-change-this-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Jakarta

# OpenWA
OPENWA_API_KEY=your_openwa_api_key
OPENWA_BASE_URL=http://localhost:2785
OPENWA_SESSION=notify
OPENWA_DB=openwa
OPENWA_USER=postgres
OPENWA_PASSWORD=your_password
OPENWA_PORT=2785
